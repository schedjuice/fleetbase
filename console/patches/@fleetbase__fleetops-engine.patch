diff --git a/addon/components/parcel2u/cargo-shop-payment-input.js b/addon/components/parcel2u/cargo-shop-payment-input.js
new file mode 100644
index 0000000000000000000000000000000000000000..6392a40a0f12643c7021fc131138e8f1327ec7d7
--- /dev/null
+++ b/addon/components/parcel2u/cargo-shop-payment-input.js
@@ -0,0 +1,17 @@
+import Component from '@glimmer/component';
+import { action } from '@ember/object';
+
+/**
+ * Parcel2U "Cargo Shop Payment": what the driver pays the cargo shop to
+ * release this item, in integer cents like the entity's price. It lives in
+ * entity meta (`cargo_shop_payment`) because entities have no column for it.
+ */
+export default class Parcel2uCargoShopPaymentInputComponent extends Component {
+    // Read once: feeding updates back into MoneyInput's <Input> would overwrite AutoNumeric's formatting.
+    initialValue = this.args.entity?.meta?.cargo_shop_payment ?? 0;
+
+    @action update(cents) {
+        const entity = this.args.entity;
+        entity.meta = { ...(entity.meta ?? {}), cargo_shop_payment: cents };
+    }
+}
